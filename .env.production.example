PORT=4000
NODE_ENV=production
JWT_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://<frontend-production-domain>
TRUST_PROXY=true
BUSINESS_TIMEZONE=America/Managua
AUTO_MIGRATE=false
ALLOW_DEMO_SEED=false
ALLOW_LEGACY_MIGRATION=false
LEGACY_MIGRATION_CONFIRMATION=
TURSO_DATABASE_URL=libsql://<database>.turso.io
TURSO_AUTH_TOKEN=<turso-production-token>
